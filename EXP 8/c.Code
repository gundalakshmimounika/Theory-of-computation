#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int i, len, flag = 0;

    printf("Enter a binary string: ");
    scanf("%s", str);

    len = strlen(str);

    // Check whether the string contains only 0 and 1
    for(i = 0; i < len; i++)
    {
        if(str[i] != '0' && str[i] != '1')
        {
            printf("The string does not belong to the grammar.\n");
            return 0;
        }
    }

    // Check for the substring "101"
    for(i = 0; i <= len - 3; i++)
    {
        if(str[i] == '1' && str[i + 1] == '0' && str[i + 2] == '1')
        {
            flag = 1;
            break;
        }
    }

    if(flag)
        printf("The string belongs to the grammar.\n");
    else
        printf("The string does not belong to the grammar.\n");

    return 0;
}
