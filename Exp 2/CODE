/* ===============================================================
   Program : NFA to accept strings over {0,1} that START WITH '0'
              AND END WITH '1'
   Simulated using the SUBSET (set-of-states) method
   =============================================================== */

#include <stdio.h>
#include <string.h>

#define NUM_STATES 3   /* q0, q1, q2 */
#define Q0 0
#define Q1 1
#define Q2 2           /* accepting state */

int nfa[NUM_STATES][2] = {
    /*      on '0'        on '1'      */
    /*Q0*/ {1 << Q1,      0        },
    /*Q1*/ {1 << Q1,      (1<<Q1)|(1<<Q2)},
    /*Q2*/ {0,            0        }
};

void printStateSet(int set)
{
    int first = 1;
    printf("{ ");
    for (int i = 0; i < NUM_STATES; i++) {
        if (set & (1 << i)) {
            if (!first) printf(", ");
            printf("q%d", i);
            first = 0;
        }
    }
    if (first) printf("-");
    printf(" }");
}

int main()
{
    char str[100];
    char choice;

    do {
        int currentSet = (1 << Q0);
        int i;

        printf("\nEnter a string (0/1 only): ");
        scanf("%s", str);

        printf("Start set        : ");
        printStateSet(currentSet);
        printf("\n");

        for (i = 0; i < (int)strlen(str); i++) {
            int symbol = str[i] - '0';
            int nextSet = 0, s;

            for (s = 0; s < NUM_STATES; s++)
                if (currentSet & (1 << s))
                    nextSet |= nfa[s][symbol];

            currentSet = nextSet;

            printf("After reading '%c' : ", str[i]);
            printStateSet(currentSet);
            printf("\n");
        }

        if (currentSet & (1 << Q2))
            printf("String \"%s\" is ACCEPTED by the NFA.\n", str);
        else
            printf("String \"%s\" is REJECTED by the NFA.\n", str);

        printf("Check another string? (y/n): ");
        scanf(" %c", &choice);

    } while (choice == 'y' || choice == 'Y');

    return 0;
}
